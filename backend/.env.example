# FloraMW Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit .env with real credentials to source control.

PROJECT_NAME="FloraMW Botanical Companion API"
VERSION=0.1.0
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development: SQLite file database in backend/ directory (default)
# Production:  postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///floramw.db

# ---------------------------------------------------------------------------
# CORS — Cross-Origin Resource Sharing
# ---------------------------------------------------------------------------
# Mobile native apps (Android/iOS) are not subject to browser CORS.
# Flutter Web or a browser-hosted client does require an explicit origin list.
#
# Development default:  wildcard ["*"] — works for native Flutter; credentials must be False.
# Production example:   CORS_ORIGINS='["https://app.floramw.com"]'
#                        CORS_ALLOW_CREDENTIALS=true
#
# IMPORTANT: ["*"] and CORS_ALLOW_CREDENTIALS=true are mutually exclusive
# (browsers reject such responses per the CORS spec).
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Transport Security — HSTS
# ---------------------------------------------------------------------------
# HSTS is emitted only over HTTPS. Never enable over plain HTTP in development.
# Set ENABLE_HSTS=true only when the API is exclusively served via HTTPS
# (e.g. behind a TLS-terminating reverse proxy in production).
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000

# ---------------------------------------------------------------------------
# Upload Limits (identification image uploads)
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_DIMENSION_PX=4096
MAX_IMAGE_TOTAL_PIXELS=16777216
UPLOAD_STREAM_CHUNK_SIZE=65536

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# RATE_LIMIT_STORAGE: "memory" (single-process dev) or "redis" (multi-process prod)
# RATE_LIMIT_REDIS_URL: required only when RATE_LIMIT_STORAGE=redis
# RATE_LIMIT_FAIL_OPEN: true = allow requests on backend failure (graceful); false = deny
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_FAIL_OPEN=true

# Rate limits: plant identification (POST /api/v1/identifications)
RATE_LIMIT_IDENTIFICATION_PER_MINUTE=5
RATE_LIMIT_IDENTIFICATION_BURST=15

# Rate limits: catalogue and district browsing (GET /api/v1/plants*, GET /api/v1/districts*)
RATE_LIMIT_CATALOGUE_PER_MINUTE=60
RATE_LIMIT_CATALOGUE_BURST=120

# Rate limits: anonymous identity creation (POST /api/v1/auth/anonymous)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AUTH_BURST=20

# Reverse proxy trust for X-Forwarded-For client IP resolution.
# Set RATE_LIMIT_TRUST_PROXY_HEADERS=true only behind a trusted reverse proxy.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_TRUSTED_PROXIES=["127.0.0.1","::1"]

# Shared-IP burst multiplier for Malawi CGNAT environments (aggregate IP ceiling)
RATE_LIMIT_SHARED_IP_BURST_MULTIPLIER=5

# ---------------------------------------------------------------------------
# Identification Provider Configuration
# ---------------------------------------------------------------------------
# Options: "deterministic" (mock dev/test only), "plantnet", "internal", "disabled"
# ALLOW_MOCK_PROVIDER must be true to use "deterministic" outside production.
# "deterministic" is forbidden automatically when ENVIRONMENT=production.
IDENTIFICATION_PROVIDER=deterministic
ALLOW_MOCK_PROVIDER=true

# Processing lease timeout for idempotency reservation recovery (seconds)
IDENTIFICATION_PROCESSING_LEASE_SECONDS=60

# Confidence band thresholds (0.0–1.0, provider scores are not independently calibrated)
CONFIDENCE_THRESHOLD_HIGH=0.70
CONFIDENCE_THRESHOLD_MODERATE=0.45
CONFIDENCE_THRESHOLD_LOW=0.20

# ---------------------------------------------------------------------------
# Pl@ntNet API Integration
# ---------------------------------------------------------------------------
# Free API key registration: https://my.plantnet.org/
# Set your actual key here in .env (never commit to git).
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
PLANTNET_TIMEOUT_SECONDS=15.0
PLANTNET_CONNECT_TIMEOUT_SECONDS=5.0
PLANTNET_DEFAULT_ORGAN=auto
PLANTNET_LANGUAGE=en
PLANTNET_MAX_RESULTS=10

# ---------------------------------------------------------------------------
# Internal Botanical Identification Model (ML Team Integration)
# ---------------------------------------------------------------------------
# Mode: "mock" (testing/CI simulation), "artifact" (local ONNX/etc file),
#       "service" (hosted HTTP inference), "disabled"
# See: backend/CONTRACT_ML_INTEGRATION.md for full integration requirements.
INTERNAL_MODEL_MODE=mock
INTERNAL_MODEL_ID=floramw-internal-v1
INTERNAL_MODEL_VERSION=0.1.0
INTERNAL_MODEL_ARTIFACT_PATH=
INTERNAL_MODEL_SERVICE_URL=
INTERNAL_MODEL_TIMEOUT_SECONDS=5.0
INTERNAL_MODEL_LABELS_PATH=
INTERNAL_MODEL_INPUT_SIZE=224
# Download the release assets and install reviewed labels on the server before enabling artifact mode.
# INTERNAL_MODEL_MODE=artifact
# INTERNAL_MODEL_ARTIFACT_PATH=/opt/floramw/models/mobilenetv2_flora.tflite
# INTERNAL_MODEL_LABELS_PATH=/opt/floramw/models/labels.json
