# FloraMW Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit .env with real credentials to source control.

PROJECT_NAME="FloraMW Botanical Companion API"
VERSION=0.1.0
ENVIRONMENT=development

# Database configuration
# Development: SQLite file database in backend/ directory
# Production: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///floramw.db

# Identification Provider Configuration
# Options: "deterministic" (mock development only), "plantnet", "internal", "disabled"
IDENTIFICATION_PROVIDER=deterministic
ALLOW_MOCK_PROVIDER=true

# Pl@ntNet API Integration
# Free API key registration: https://my.plantnet.org/
# Set your actual key here in .env (never commit to git):
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
PLANTNET_TIMEOUT_SECONDS=15.0
PLANTNET_CONNECT_TIMEOUT_SECONDS=5.0
PLANTNET_DEFAULT_ORGAN=auto
PLANTNET_LANGUAGE=en
PLANTNET_MAX_RESULTS=10

# Internal Botanical Identification Model (ML Team Integration)
# Mode: "mock" (testing/CI simulation), "artifact" (local ONNX/etc file), "service" (hosted HTTP inference)
# See: backend/CONTRACT_ML_INTEGRATION.md for full integration requirements.
INTERNAL_MODEL_MODE=mock
INTERNAL_MODEL_ID=floramw-internal-v1
INTERNAL_MODEL_VERSION=0.1.0
INTERNAL_MODEL_ARTIFACT_PATH=
INTERNAL_MODEL_SERVICE_URL=
INTERNAL_MODEL_TIMEOUT_SECONDS=5.0
INTERNAL_MODEL_LABELS_PATH=
